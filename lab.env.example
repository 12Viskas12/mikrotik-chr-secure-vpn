# copy to lab.env and edit, no spaces around =

# password for the CHR user admin and the VM user lab, letters and digits only
ADMIN_PASSWORD=

# public key for the CHR and the VMs, empty means ~/.ssh/id_ed25519.pub
SSH_PUBKEY_FILE=

# host interface with internet, empty means the interface of the default route
UPLINK_IFACE=

# "latest" or a fixed version such as 7.16.2
CHR_VERSION=latest

DEBIAN_IMG_URL=https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-generic-amd64.qcow2

# empty means the simulated gateway VM, for a real server put its address here
WG_ENDPOINT_HOST=
WG_PORT=51820

# yes means clients can talk only through the CHR
CLIENT_ISOLATION=yes
