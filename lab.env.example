# Copy to lab.env (git-ignored) and edit. Sourced by bash, so no spaces around '='.

# REQUIRED. Password for the CHR 'admin' user and the VM console user 'lab'.
# Letters and digits only (it is pasted into a RouterOS script).
ADMIN_PASSWORD=

# Public key that is installed on the CHR and the VMs (default: ~/.ssh/id_ed25519.pub)
SSH_PUBKEY_FILE=

# Host interface with internet access (default: interface of the default route)
UPLINK_IFACE=

# MikroTik CHR version: "latest" (stable channel) or a pinned version such as 7.16.2
CHR_VERSION=latest

# Debian cloud image used for the remote gateway, remote server and clients
DEBIAN_IMG_URL=https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-generic-amd64.qcow2

# Remote WireGuard endpoint the CHR connects to.
# Lab default (empty) = the simulated remote gateway VM. For the real server put its public IP/DNS name here.
WG_ENDPOINT_HOST=
WG_PORT=51820

# Put the two client taps in bridge "isolated" mode so clients can only talk through the CHR (yes/no)
CLIENT_ISOLATION=yes
